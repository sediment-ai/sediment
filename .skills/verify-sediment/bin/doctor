#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Read-only check: is this verify instance worth driving?
set -euo pipefail
# shellcheck source=common.sh
source "$(cd "$(dirname "$0")" && pwd)/common.sh"
_verify_load_state

fail=0
say() { printf '%s\n' "$*"; }
bad() { say "FAIL: $*"; fail=1; }
ok() { say "OK: $*"; }

if ! kill -0 "${SEDIMENT_VERIFY_PID}" 2>/dev/null; then
  bad "server pid ${SEDIMENT_VERIFY_PID} is not running"
else
  ok "server pid ${SEDIMENT_VERIFY_PID} is running"
fi

health_file="$(mktemp)"
if ! curl -sf "${SEDIMENT_VERIFY_URL}/health" >"$health_file"; then
  bad "GET ${SEDIMENT_VERIFY_URL}/health failed"
else
  if python3 -c 'import json,sys; d=json.load(open(sys.argv[1]));
print(d.get("version",""));
raise SystemExit(0 if d.get("status")=="ok" and d.get("version") else 1)' \
    "$health_file" >"${health_file}.ver"; then
    ver="$(cat "${health_file}.ver")"
    ok "health status=ok version=${ver} url=${SEDIMENT_VERIFY_URL}"
  else
    bad "health body missing status=ok or version: $(cat "$health_file")"
  fi
fi
rm -f "$health_file" "${health_file}.ver"

server_env="${SEDIMENT_VERIFY_SERVER_ENV}"
if [[ ! -f "$server_env" ]]; then
  bad "missing ${server_env}"
else
  mode="$(stat -c '%a' "$server_env" 2>/dev/null || stat -f '%OLp' "$server_env")"
  if [[ "$mode" != "600" ]]; then
    bad "${server_env} mode is ${mode}, expected 600"
  else
    ok "credentials at ${server_env} mode 600"
  fi
fi

if [[ ! -d "${SEDIMENT_VERIFY_HOME}/.sediment/server" ]]; then
  bad "missing server root under ${SEDIMENT_VERIFY_HOME}"
else
  ok "server root ${SEDIMENT_VERIFY_HOME}/.sediment/server"
fi

say "run_id=${SEDIMENT_VERIFY_RUN_ID}"
say "home=${SEDIMENT_VERIFY_HOME}"
say "evidence=${SEDIMENT_VERIFY_EVIDENCE}"
exit "$fail"
