{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sediment.so/schemas/trainer-messages/text-message/v1.json",
  "title": "TrainerTextMessage",
  "description": "One developer, system, or user message.",
  "type": "object",
  "properties": {
    "role": {
      "enum": [
        "developer",
        "system",
        "user"
      ],
      "type": "string",
      "description": "The trainer-facing message role."
    },
    "content": {
      "type": "string",
      "description": "Plain-text message content."
    }
  },
  "additionalProperties": false,
  "required": [
    "role",
    "content"
  ]
}
