{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sediment.so/schemas/derived-artifacts/repository-identity/v1.json",
  "title": "RepositoryIdentity",
  "description": "One immutable provider repository identity.",
  "type": "object",
  "properties": {
    "provider": {
      "const": "github",
      "type": "string",
      "description": "The forge provider that assigns the immutable repository ID."
    },
    "host": {
      "type": "string",
      "pattern": "^[^\\u0000\\uD800-\\uDFFF]*$",
      "description": "The lowercase configured forge host."
    },
    "repository_id": {
      "type": "string",
      "pattern": "^[^\\u0000\\uD800-\\uDFFF]*$",
      "description": "Immutable provider repository ID within its forge host."
    }
  },
  "additionalProperties": false,
  "required": [
    "provider",
    "host",
    "repository_id"
  ]
}
