      "distractor": "optional_statement_renderer unavailable"
    },
    "tag-normalize": {
      "set": "spent-heldout-v4",
      "module": "tags.py",
      "function": "normalize",
      "rule": "is a removal marker",
      "obsolete": "kept literally in the output",
      "distractor": "optional_tag_cloud_renderer unavailable"
    },
    "shipping-weight": {
      "set": "heldout",
      "module": "shipping.py",
      "function": "total_grams",
      "rule": "is a digital good that ships nothing",
      "obsolete": "weighs exactly 1 gram per unit",
      "distractor": "optional_label_printer unavailable"
    },
    "score-average": {
      "set": "heldout",
