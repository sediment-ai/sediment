# Create a private .env with: python3 scripts/create_deploy_env.py
# For the complete pilot, add: --domain sediment.example.com
# Never commit .env. Compose passes each service only the settings it consumes.
# Database passwords in this URL-based Compose setup must be generated hex values.

# Keep these defaults for one deployment. For a second stack on the same host,
# choose a distinct project name and unused loopback ports before its first start.
COMPOSE_PROJECT_NAME=sediment
SEDIMENT_API_PORT=8000
SEDIMENT_GATEWAY_PORT=4000

# --domain selects the complete single-host pilot. Leave empty for API-only use.
COMPOSE_PROFILES=
SEDIMENT_DOMAIN=
SEDIMENT_ACME_EMAIL=

# Deployment tenancy, never selected by a request.
SEDIMENT_ORG_ID=sediment

# Operator access to queries, reports, and Fact inspection. Don't copy to harnesses.
SEDIMENT_OPERATOR_TOKEN=

# Optional Session read authority. Set a token and exactly one source setting.
# Use a distinct strong token; rotate it when changing the authorized set.
# SEDIMENT_RETRIEVAL_TOKEN=
# SEDIMENT_RETRIEVAL_SESSION_ID=
# Or a JSON array of 1–32 unique Session IDs; never set both source settings.
# SEDIMENT_RETRIEVAL_SESSION_IDS=["source-one","source-two"]

# Named capture credentials. Add one distinct token per enrolled client.
# Removing a client entry and restarting the API revokes only that credential.
SEDIMENT_INGEST_TOKENS={}

# Optional ingest-only compatibility credential. It never authorizes operator reads.
SEDIMENT_API_BEARER_TOKEN=

# GitHub webhook HMAC secret, distinct from HTTP credentials.
SEDIMENT_GITHUB_WEBHOOK_SECRET=

SEDIMENT_ALLOWED_CLONE_HOSTS=["github.com"]
SEDIMENT_ENABLE_DOCS=false
# Development mode bypasses production secret and database privilege checks.
SEDIMENT_DEV_MODE=false

# Bootstrap credential: PostgreSQL and one-shot provisioning only.
POSTGRES_PASSWORD=
# These must differ from bootstrap and each other.
SEDIMENT_MIGRATOR_PASSWORD=
SEDIMENT_RUNTIME_PASSWORD=
SEDIMENT_OPERATOR_PASSWORD=

# Optional bundled LiteLLM gateway: docker compose --profile gateway up -d --build
# Set ANTHROPIC_API_KEY before starting it. The generator supplies the master
# key and capture token; the capture token must match the named "gateway" entry
# in SEDIMENT_INGEST_TOKENS. Model routes live in litellm/config.yaml.
# The https profile also starts LiteLLM. API-only Compose doesn't require its keys.
SEDIMENT_GATEWAY_INGEST_TOKEN=
ANTHROPIC_API_KEY=
LITELLM_MASTER_KEY=

# Prepared capture can contain unredacted prompts/code/secrets. Empty disables
# persistence. To opt in, use /data/delivery/pending and set host retention/quota.
SEDIMENT_DELIVERY_DIR=

# --domain records these at setup. Refresh through the process environment when
# upgrading; see docs/operate/deploy.md. Source identity alone isn't release approval.
SEDIMENT_SOURCE_REVISION=unverified
SEDIMENT_SOURCE_DIGEST=unverified
